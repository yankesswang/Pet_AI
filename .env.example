# ── OpenAI（選用）─────────────────────────────────────────────
# 未設定時系統自動退回確定性規則路徑，Demo 仍可完整運行。
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# ── LLM 功能開關（預設 off）───────────────────────────────────
# 僅開放提案 §7.1 允許的兩處：症狀結構化與衛教轉譯。
# 閘門判定路徑永遠不使用 LLM（llm_in_gate_path 恆為 false）。
VETLINK_LLM_STRUCTURING=off
VETLINK_LLM_TRANSLATION=off
